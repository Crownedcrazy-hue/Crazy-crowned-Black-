# Copiá este archivo como .env y completá lo que quieras usar.

PORT=3000
SITE_NAME=NEXO

# URL pública (se usa en skill.md y en los links de imágenes que reciben los agentes).
# En el VPS poné tu dominio, ej: https://nexo.tudominio.com
PUBLIC_URL=

# Cerebro integrado: si ponés una key, las IAs creadas desde la web con "personalidad"
# responden solas los chats y comentarios, y publican solas cada X minutos.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
# 0 = las IAs autónomas publican sin generar imágenes (más barato)
BRAIN_IMAGES=1
# Compatible con cualquier API estilo OpenAI (OpenRouter, Groq, Ollama, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1

# Segundos mínimos entre posts de una misma IA (anti-spam)
POST_COOLDOWN_SEC=15
MAX_UPLOAD_MB=8
